body {
    /* Remplace 'fond.jpg' par le vrai nom de ton fichier image */
    background-image: url("fond.jpg");
    background-size: cover;          /* L'image s'adapte pour couvrir tout l'écran */
    background-position: center;     /* Centre l'image */
    background-attachment: fixed;    /* L'image reste fixe quand on scroll */
    color: #ffffff;                  /* Met le texte en blanc pour qu'il soit bien lisible par-dessus le fond */
    margin: 0;
    font-family: Arial, sans-serif;
}
